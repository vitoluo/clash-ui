// 基于 slintcn table 源码，按项目 Theme 和规则页布局要求适配。

import { Theme } from "../theme.slint";
import { ListView } from "list-view.slint";
import { IconDisplay, IconSet } from "@lucide";
import { Separator } from "separator.slint";

export struct TableRow {
    id: string,
    cells: [string],
    secondary-content: string,
}

export component TableBodyRow inherits Rectangle {
    in property <TableRow> data;
    in property <[float]> column-width-ratios: [0.34, 0.33, 0.33];
    in property <bool> show-secondary: false;
    in property <bool> show-divider: false;
    callback clicked(string);
    property <length> row-height: 40px;
    property <length> cell-padding: Theme.spacing-sm;
    out property <length> content-width: root.width - 2 * root.cell-padding;
    background: row-touch.has-hover ? Theme.surface-1 : Theme.canvas;

    animate background {
        duration: Theme.duration-hover;
        easing: Theme.easing-hover;
    }

    row-touch := TouchArea {
        mouse-cursor: root.data.id == "" ? default : pointer;
        clicked => {
            if (root.data.id != "") { root.clicked(root.data.id); }
        }
    }

    row-container := VerticalLayout {
        HorizontalLayout {
            height: root.row-height;
            padding-left: root.cell-padding;
            padding-right: root.cell-padding;

            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    for cell[cell-index] in root.data.cells: Text {
                        width: root.content-width * root.column-width-ratios[cell-index];
                        text: cell;
                        color: Theme.ink-subtle;
                        font-size: Theme.typography-mono;
                        overflow: elide;

                        if self.preferred-width > self.width: Tooltip {
                            text: @markdown("\{cell}");
                        }
                    }
                }

                if root.show-secondary: Text {
                    text: root.data.secondary-content;
                    color: Theme.ink-tertiary;
                    font-size: Theme.typography-caption;
                    overflow: elide;

                    if self.preferred-width > self.width: Tooltip {
                        text: @markdown("\{root.data.secondary-content}");
                    }
                }
            }

            @children
        }

        if root.show-divider: Separator { }
    }
}

export component Table inherits Rectangle {
    in property <[string]> columns;
    in property <[float]> column-width-ratios: [0.34, 0.33, 0.33];
    in property <bool> sortable: false;
    in property <int> sort-column: -1;
    in property <int> sort-direction: 0;
    callback header-clicked(int);
    property <length> header-height: 40px;
    property <length> cell-padding: Theme.spacing-sm;
    property <length> content-width: root.width - 2 * root.cell-padding;

    border-radius: Theme.rounded-md;
    clip: true;

    table-container := VerticalLayout {
        table-header := Rectangle {
            height: root.header-height;
            background: Theme.surface-2;
            HorizontalLayout {
                padding-left: root.cell-padding;
                padding-right: root.cell-padding;

                for col[index] in root.columns: Rectangle {
                    width: root.content-width * root.column-width-ratios[index];
                    if root.sortable: TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.header-clicked(index); }
                    }
                    HorizontalLayout {
                        spacing: Theme.spacing-xxs;
                        cross-axis-alignment: center;
                        Text {
                            horizontal-stretch: 0;
                            text: col;
                            color: Theme.ink;
                            font-size: Theme.typography-mono;
                            font-weight: Theme.typography-weight-semibold;
                            overflow: elide;

                            if self.preferred-width > self.width: Tooltip {
                                text: @markdown("\{col}");
                            }
                        }

                        if root.sortable && root.sort-column == index: IconDisplay {
                            icon: root.sort-direction < 0 ? IconSet.ChevronUp : IconSet.ChevronDown;
                            size: Theme.typography-body-sm;
                            stroke: Theme.ink-subtle;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }

        Separator { }

        @children
    }
}
