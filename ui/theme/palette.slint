// 项目主题原始值层：仅保存颜色、透明度和不可变基础值。

export global Palette {
    // 画布与表面。
    out property <color> canvas-dark: #010102;
    out property <color> surface-1-dark: #0f1011;
    out property <color> surface-2-dark: #141516;
    out property <color> hairline-dark: #23252a;
    out property <color> hairline-strong-dark: #34343a;

    out property <color> canvas-light: #ffffff;
    out property <color> surface-1-light: #f6f8fa;
    out property <color> surface-2-light: #eceef0;
    out property <color> hairline-light: #dddedc;
    out property <color> hairline-strong-light: #cccfcc;

    // 文字。
    out property <color> ink-dark: #f7f8f8;
    out property <color> ink-muted-dark: #d0d6e0;
    out property <color> ink-subtle-dark: #8a8f98;
    out property <color> ink-tertiary-dark: #62666d;

    out property <color> ink-light: #000000;
    out property <color> ink-muted-light: #2f3033;
    out property <color> ink-subtle-light: #5c5d62;
    out property <color> ink-tertiary-light: #8a8b90;

    // 强调色与语义色。
    out property <color> primary: #5e6ad2;
    out property <color> on-primary: #ffffff;
    out property <color> primary-hover: #828fff;
    out property <color> primary-focus: #5e69d1;
    out property <color> brand-secure: #7a7fad;
    out property <color> semantic-success: #27a644;
    out property <color> semantic-overlay: #00000040;

    out property <color> semantic-warning: #eab308;
    out property <color> semantic-danger: #dc2626;
    out property <color> net-up: #3b82f6;
    out property <color> net-down: #27a644;
    out property <color> hover-light: rgba(0, 0, 0, 0.04);
    out property <color> hover-dark: rgba(255, 255, 255, 0.08);

    out property <color> scroll-light: rgba(0,0,0,0.1);
    out property <color> scroll-focus-light: rgba(0,0,0,0.3);

    out property <color> scroll-dark: rgba(255, 255, 255,0.2);
    out property <color> scroll-focus-dark: rgba(255, 255, 255,0.4);
}
